<script lang="ts">
  let show = true

  function toggle() {
    show = !show
  }
</script>

<template>
  <main>
    <h1>zoom lab</h1>
    <button type="button" on:click={toggle}>Toggle</button>
    {#if show}
      <p data-zoom-target transition:zoom={{ start: 0.5, duration: 50 }}>Zoomed in</p>
    {/if}
  </main>
</template>
