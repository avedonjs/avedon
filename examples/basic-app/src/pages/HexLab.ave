<script lang="ts">
  import { hex, signal } from '@avedon/runtime'

  const out = signal('')

  function onInput(e: Event) {
    const t = e.target as HTMLInputElement
    out.set(t.value)
  }
</script>

<template>
  <main>
    <h1>hex lab</h1>
    <input data-hex type="text" use:hex on:input={onInput} />
    <p data-out>{out.get()}</p>
  </main>
</template>
