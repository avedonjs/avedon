<script lang="ts">
  import { signal, uppercase } from '@avedon/runtime'

  const out = signal('idle')

  function onInput(e: Event) {
    const t = e.target as HTMLInputElement
    out.set(t.value)
  }
</script>

<template>
  <main>
    <h1>uppercase lab</h1>
    <input data-uppercase type="text" value="avedOn" use:uppercase on:input={onInput} />
    <p data-out>{out.get()}</p>
  </main>
</template>
