<script lang="ts">
  import { currency, signal } from '@avedon/runtime'

  const out = signal('')

  function onInput(e: Event) {
    const t = e.target as HTMLInputElement
    out.set(t.value)
  }
</script>

<template>
  <main>
    <h1>currency lab</h1>
    <input data-currency type="text" use:currency on:input={onInput} />
    <p data-out>{out.get()}</p>
  </main>
</template>
