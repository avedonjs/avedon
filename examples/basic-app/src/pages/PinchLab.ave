<script lang="ts">
  import { pinch, signal } from '@avedon/runtime'

  const scale = signal('1.00')

  function onPinch(info: { scale: number }) {
    scale.set(info.scale.toFixed(2))
  }
</script>

<style scoped>
  .pad {
    width: 220px;
    height: 140px;
    border: 1px solid #333;
    display: grid;
    place-items: center;
    touch-action: none;
  }
</style>

<template>
  <main>
    <h1>pinch lab</h1>
    <div class="pad" data-pinch use:pinch={onPinch}>Pinch</div>
    <p data-pinch-scale>{scale.get()}</p>
  </main>
</template>
