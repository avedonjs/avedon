<script lang="ts">
  import { signal, trim } from '@avedon/runtime'

  const out = signal('idle')

  function onInput(e: Event) {
    const t = e.target as HTMLInputElement
    out.set(t.value)
  }
</script>

<template>
  <main>
    <h1>trim lab</h1>
    <input data-trim type="text" value="  avedon  " use:trim on:input={onInput} />
    <p data-out>{out.get()}</p>
  </main>
</template>
