<script lang="ts">
  let show = true

  function toggle() {
    show = !show
  }
</script>

<template>
  <main>
    <h1>drop lab</h1>
    <button type="button" on:click={toggle}>Toggle</button>
    {#if show}
      <p data-drop-target transition:drop={{ start: 0.9, y: -24, duration: 50 }}>Dropped in</p>
    {/if}
  </main>
</template>
