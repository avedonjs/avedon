<script lang="ts">
  import { signal, trimStart } from '@avedon/runtime'

  const out = signal('idle')

  function onInput(e: Event) {
    const t = e.target as HTMLInputElement
    out.set(t.value)
  }
</script>

<template>
  <main>
    <h1>trimStart lab</h1>
    <input data-trim-start type="text" use:trimStart on:input={onInput} />
    <p data-out>{out.get()}</p>
  </main>
</template>
