<script lang="ts">
  let show = true

  function toggle() {
    show = !show
  }
</script>

<template>
  <main>
    <h1>fade outro lab</h1>
    <button type="button" on:click={toggle}>Toggle</button>
    {#if show}
      <p data-fade-outro transition:fade={{ duration: 50 }}>Hello</p>
    {/if}
  </main>
</template>
