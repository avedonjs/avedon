<script lang="ts">
  let text = 'hello world'
  let start = 0
  let end = 0

  function selectWord() {
    start = 6
    end = 11
  }
</script>

<template>
  <main>
    <h1>selection bind lab</h1>
    <button type="button" on:click={selectWord}>Select word</button>
    <input data-sel bind:value={text} bind:selectionStart={start} bind:selectionEnd={end} />
    <p data-sel-start>{start}</p>
    <p data-sel-end>{end}</p>
  </main>
</template>
