<script lang="ts">
  let show = true

  function toggle() {
    show = !show
  }
</script>

<template>
  <main>
    <h1>shake lab</h1>
    <button type="button" on:click={toggle}>Toggle</button>
    {#if show}
      <p data-shake-target transition:shake={{ x: 12, duration: 50 }}>Shaken in</p>
    {/if}
  </main>
</template>
