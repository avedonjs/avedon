<script lang="ts">
  import { signal, swapCase } from '@avedon/runtime'

  const out = signal('idle')

  function onInput(e: Event) {
    const t = e.target as HTMLInputElement
    out.set(t.value)
  }
</script>

<template>
  <main>
    <h1>swapCase lab</h1>
    <input data-swap-case type="text" use:swapCase on:input={onInput} />
    <p data-out>{out.get()}</p>
  </main>
</template>

