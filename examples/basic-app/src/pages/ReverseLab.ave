<script lang="ts">
  import { reverse, signal } from '@avedon/runtime'

  const out = signal('idle')

  function onInput(e: Event) {
    const t = e.target as HTMLInputElement
    out.set(t.value)
  }
</script>

<template>
  <main>
    <h1>reverse lab</h1>
    <input data-reverse type="text" use:reverse on:input={onInput} />
    <p data-out>{out.get()}</p>
  </main>
</template>

