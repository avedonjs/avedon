<script lang="ts">
  import { lowercase, signal } from '@avedon/runtime'

  const out = signal('idle')

  function onInput(e: Event) {
    const t = e.target as HTMLInputElement
    out.set(t.value)
  }
</script>

<template>
  <main>
    <h1>lowercase lab</h1>
    <input data-lowercase type="text" value="AvedOn" use:lowercase on:input={onInput} />
    <p data-out>{out.get()}</p>
  </main>
</template>
