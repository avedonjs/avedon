<script lang="ts">
  import { capitalize, signal } from '@avedon/runtime'

  const out = signal('idle')

  function onInput(e: Event) {
    const t = e.target as HTMLInputElement
    out.set(t.value)
  }
</script>

<template>
  <main>
    <h1>capitalize lab</h1>
    <input data-capitalize type="text" value="hello world" use:capitalize on:input={onInput} />
    <p data-out>{out.get()}</p>
  </main>
</template>
