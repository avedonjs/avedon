<script lang="ts">
  import DocsSidebar from '../components/DocsSidebar.ave'
  import Toc from '../components/Toc.ave'
  import Pager from '../components/Pager.ave'

  export let html
  export let headings
  export let groups
  export let slug
  export let title
  export let prev
  export let next
</script>

<script server>
  import { notFound } from '@avedon/server'
  import { getAdjacentDocs, getDoc, listNavGroups } from '../lib/docs'

  export async function load({ params }) {
    const entry = getDoc(params.slug)
    if (!entry) throw notFound()
    const { prev, next } = getAdjacentDocs(entry.slug)
    return {
      title: entry.title,
      html: entry.html,
      headings: entry.headings,
      groups: listNavGroups(false),
      slug: entry.slug,
      prev,
      next,
      head: {
        title: `${entry.title} — avedon`,
        description: entry.blurb,
      },
    }
  }
</script>

<style unscoped>
  .docs-shell {
    display: grid;
    grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr) minmax(10rem, 14rem);
    gap: 2rem;
    width: min(100%, 80rem);
    margin: 0 auto;
    padding: 1.5rem clamp(1rem, 3vw, 2rem) 3rem;
    box-sizing: border-box;
  }

  .docs-shell .prose {
    max-width: 42rem;
    line-height: 1.6;
    font-size: 1.02rem;
  }

  .docs-shell .prose a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .docs-shell .prose h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .docs-shell .prose h2 {
    margin: 2rem 0 0.75rem;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .docs-shell .prose h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.1rem;
  }

  .docs-shell .prose p,
  .docs-shell .prose ul,
  .docs-shell .prose ol {
    margin: 0 0 1rem;
  }

  .docs-shell .prose li {
    margin-bottom: 0.35rem;
  }

  .docs-shell .prose a {
    color: var(--accent);
  }

  .docs-shell .prose pre {
    margin: 0 0 1.25rem;
    padding: 1rem 1.1rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: #0a0c10;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .docs-shell .prose pre.shiki {
    background: #0a0c10;
  }

  .docs-shell .prose pre code {
    display: block;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88rem;
    background: transparent;
    padding: 0;
    white-space: pre;
  }

  .docs-shell .prose code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }

  .docs-shell .prose :not(pre) > code {
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    background: rgba(250, 250, 250, 0.06);
  }

  .docs-shell .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
  }

  .docs-shell .prose th,
  .docs-shell .prose td {
    border: 1px solid var(--line);
    padding: 0.5rem 0.65rem;
    text-align: left;
  }

  @media (max-width: 960px) {
    .docs-shell {
      grid-template-columns: minmax(12rem, 14rem) minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .docs-shell {
      grid-template-columns: 1fr;
    }
  }
</style>

<template>
  <div class="docs-shell">
    <DocsSidebar groups={groups} slug={slug} />
    <article class="prose">
      {@html html}
      <Pager prev={prev} next={next} />
    </article>
    <Toc headings={headings} />
  </div>
</template>
