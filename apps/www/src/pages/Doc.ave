<script lang="ts">
  import DocsSidebar from '../components/DocsSidebar.ave'
  import Toc from '../components/Toc.ave'
  import Pager from '../components/Pager.ave'

  export let html
  export let headings
  export let groups
  export let slug
  export let title
  export let prev
  export let next
</script>

<script server>
  import { notFound } from '@avedon/server'
  import { getAdjacentDocs, getDoc, listNavGroups } from '../lib/docs'

  export async function load({ params }) {
    const entry = getDoc(params.slug)
    if (!entry) throw notFound()
    const { prev, next } = getAdjacentDocs(entry.slug)
    return {
      title: entry.title,
      html: entry.html,
      headings: entry.headings,
      groups: listNavGroups(false),
      slug: entry.slug,
      prev,
      next,
      head: {
        title: `${entry.title} — avedon`,
        description: entry.blurb,
      },
    }
  }
</script>

<template>
  <div
    class="mx-auto grid w-[min(100%,80rem)] box-border grid-cols-1 gap-8 px-[clamp(1rem,3vw,2rem)] py-6 pb-12 md:grid-cols-[minmax(12rem,14rem)_minmax(0,1fr)] lg:grid-cols-[minmax(12rem,16rem)_minmax(0,1fr)_minmax(10rem,14rem)] lg:gap-8"
  >
    <DocsSidebar groups={groups} slug={slug} />
    <article class="prose min-w-0">
      {@html html}
      <Pager prev={prev} next={next} />
    </article>
    <Toc headings={headings} />
  </div>
</template>
