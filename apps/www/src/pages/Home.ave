<script lang="ts">
  import { signal } from '@avedon/runtime'

  export let specimenHtml

  const selected = signal('npm')
  const cmd = signal('npm create avedon-app')
  const copied = signal(false)

  function pickNpm() {
    selected = 'npm'
    cmd = 'npm create avedon-app'
    copied = false
  }

  function pickPnpm() {
    selected = 'pnpm'
    cmd = 'pnpm create avedon-app'
    copied = false
  }

  function pickYarn() {
    selected = 'yarn'
    cmd = 'yarn create avedon-app'
    copied = false
  }

  function pickBun() {
    selected = 'bun'
    cmd = 'bun create avedon-app'
    copied = false
  }

  async function copyCmd() {
    try {
      await navigator.clipboard.writeText(cmd)
      copied = true
      setTimeout(() => (copied = false), 1600)
    } catch {
      copied = false
    }
  }

  /** Cursor-follow grid highlight (client-only; skipped for reduced-motion / coarse pointer). */
  function stagePointer(node: Element) {
    const el = node as HTMLElement
    if (typeof window === 'undefined') return

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const coarse = window.matchMedia('(pointer: coarse)').matches
    if (reduced || coarse) return

    const glow = el.querySelector('.stage-grid-glow') as HTMLElement | null
    let targetX = 50
    let targetY = 50
    let curX = 50
    let curY = 50
    let raf = 0
    let hovering = false

    function tick() {
      curX += (targetX - curX) * 0.14
      curY += (targetY - curY) * 0.14
      el.style.setProperty('--mx', `${curX}%`)
      el.style.setProperty('--my', `${curY}%`)
      if (Math.abs(targetX - curX) > 0.04 || Math.abs(targetY - curY) > 0.04) {
        raf = requestAnimationFrame(tick)
      } else {
        raf = 0
      }
    }

    function onMove(e: PointerEvent) {
      const rect = el.getBoundingClientRect()
      if (rect.width === 0 || rect.height === 0) return
      targetX = ((e.clientX - rect.left) / rect.width) * 100
      targetY = ((e.clientY - rect.top) / rect.height) * 100
      if (!hovering) {
        hovering = true
        glow?.classList.add('is-active')
      }
      if (!raf) raf = requestAnimationFrame(tick)
    }

    function onLeave() {
      hovering = false
      glow?.classList.remove('is-active')
    }

    el.addEventListener('pointermove', onMove)
    el.addEventListener('pointerleave', onLeave)

    return {
      destroy() {
        el.removeEventListener('pointermove', onMove)
        el.removeEventListener('pointerleave', onLeave)
        if (raf) cancelAnimationFrame(raf)
      },
    }
  }
</script>

<script server>
  import { loadHomeSpecimenHtml } from '../lib/home-specimen'

  export async function load() {
    return {
      specimenHtml: loadHomeSpecimenHtml(),
      head: {
        title: 'avedon — TypeScript-first full-stack web framework',
        description:
          'avedon is a TypeScript-first full-stack web framework: single-file .ave components, explicit typed routing, and hybrid SSR/SSG/CSR rendering.',
      },
    }
  }
</script>

<template>
  <div
    class="relative isolate flex h-[calc(100dvh-3.75rem)] max-h-[calc(100dvh-3.75rem)] flex-col overflow-hidden"
    data-www-stage
    use:stagePointer
  >
    <div class="stage-grid" aria-hidden="true"></div>
    <div class="stage-grid-glow" aria-hidden="true"></div>

    <section
      class="relative mx-auto grid min-h-0 w-[min(100%,72rem)] flex-1 grid-cols-1 items-center gap-6 px-[clamp(1.25rem,4vw,3rem)] py-5 lg:grid-cols-[minmax(0,1.05fr)_minmax(16rem,24rem)] lg:gap-10 lg:py-6"
    >
      <div class="relative z-0 flex min-w-0 flex-col gap-4 lg:gap-5">
        <p
          class="brand m-0 text-[clamp(2.75rem,8vw,5.25rem)] font-extrabold leading-none tracking-[-0.045em] text-fg"
        >
          avedon
        </p>
        <h1
          class="headline m-0 max-w-[18ch] text-[clamp(1.2rem,2.6vw,1.85rem)] font-bold leading-[1.15] tracking-[-0.03em] text-fg"
        >
          TypeScript-first full-stack web framework.
        </h1>
        <p class="support m-0 max-w-xl text-[0.98rem] leading-relaxed text-muted">
          One .ave file for UI, styles, and server logic — explicit routes, hybrid rendering, Vite
          toolchain.
        </p>

        <div class="w-full max-w-xl">
          <div class="mb-2 flex gap-1" role="tablist" aria-label="Package manager">
            <button
              type="button"
              role="tab"
              class={
                selected === 'npm'
                  ? 'min-h-9 cursor-pointer border-0 bg-accent/10 px-3 font-mono text-sm font-semibold text-accent'
                  : 'min-h-9 cursor-pointer border-0 bg-transparent px-3 font-mono text-sm font-semibold text-muted hover:text-fg'
              }
              on:click={pickNpm}
            >
              npm
            </button>
            <button
              type="button"
              role="tab"
              class={
                selected === 'pnpm'
                  ? 'min-h-9 cursor-pointer border-0 bg-accent/10 px-3 font-mono text-sm font-semibold text-accent'
                  : 'min-h-9 cursor-pointer border-0 bg-transparent px-3 font-mono text-sm font-semibold text-muted hover:text-fg'
              }
              on:click={pickPnpm}
            >
              pnpm
            </button>
            <button
              type="button"
              role="tab"
              class={
                selected === 'yarn'
                  ? 'min-h-9 cursor-pointer border-0 bg-accent/10 px-3 font-mono text-sm font-semibold text-accent'
                  : 'min-h-9 cursor-pointer border-0 bg-transparent px-3 font-mono text-sm font-semibold text-muted hover:text-fg'
              }
              on:click={pickYarn}
            >
              yarn
            </button>
            <button
              type="button"
              role="tab"
              class={
                selected === 'bun'
                  ? 'min-h-9 cursor-pointer border-0 bg-accent/10 px-3 font-mono text-sm font-semibold text-accent'
                  : 'min-h-9 cursor-pointer border-0 bg-transparent px-3 font-mono text-sm font-semibold text-muted hover:text-fg'
              }
              on:click={pickBun}
            >
              bun
            </button>
          </div>
          <div class="flex items-stretch overflow-hidden border border-line bg-[#0c0c0e]">
            <code class="min-w-0 flex-1 overflow-x-auto px-4 py-3 font-mono text-sm text-fg">
              {cmd}
            </code>
            <button
              type="button"
              class="shrink-0 cursor-pointer border-0 border-l border-line bg-transparent px-4 text-sm font-semibold text-muted transition-colors hover:bg-accent/10 hover:text-accent"
              on:click={copyCmd}
            >
              {copied ? 'Copied' : 'Copy'}
            </button>
          </div>
        </div>

        <div class="hero-ctas flex flex-wrap items-center gap-2.5">
          <a
            class="inline-flex min-h-10 items-center bg-accent px-4 text-[0.9rem] font-bold text-bg no-underline transition-colors hover:bg-accent-deep hover:text-bg"
            href="/docs/quick-start/"
          >
            Get started
          </a>
          <a
            class="inline-flex min-h-10 items-center border border-line px-4 text-[0.9rem] font-semibold text-fg no-underline transition-colors hover:border-accent hover:text-accent"
