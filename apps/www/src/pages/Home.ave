            href="https://github.com/avedonjs/avedon"
            rel="noopener noreferrer"
            target="_blank"
          >
            GitHub
          </a>
        </div>
      </div>

      <aside
        class="specimen-rise relative z-0 hidden min-h-0 min-w-0 lg:block"
        aria-label="Sample .ave component"
      >
        <div class="flex max-h-full min-h-0 flex-col overflow-hidden border border-line bg-[#0c0c0e]">
          <div
            class="flex shrink-0 items-center gap-2.5 border-b border-line px-3.5 py-2 font-mono text-xs text-muted"
          >
            <span class="size-2 shrink-0 rounded-full bg-[#f87171]" aria-hidden="true"></span>
            <span class="size-2 shrink-0 rounded-full bg-[#fbbf24]" aria-hidden="true"></span>
            <span class="size-2 shrink-0 rounded-full bg-[#34d399]" aria-hidden="true"></span>
            <span class="ml-1 text-fg/85">Counter.ave</span>
          </div>
          <div class="specimen-code min-h-0 overflow-auto">{@html specimenHtml}</div>
        </div>
      </aside>
    </section>

    <section
      class="relative mx-auto w-full shrink-0 border-t border-line px-[clamp(1.25rem,4vw,3rem)] py-3"
    >
      <div class="mx-auto flex w-[min(100%,72rem)] flex-col gap-2.5">
        <ul
          class="m-0 flex list-none flex-col gap-1.5 p-0 sm:flex-row sm:flex-wrap sm:gap-x-6 sm:gap-y-1"
          aria-label="Highlights"
        >
          <li class="flex gap-2 text-[0.8rem] leading-snug text-muted">
            <span class="text-accent" aria-hidden="true">▸</span>
            <span>.ave — UI, styles, server in one file</span>
          </li>
          <li class="flex gap-2 text-[0.8rem] leading-snug text-muted">
            <span class="text-accent" aria-hidden="true">▸</span>
            <span>Typed routes, load, actions, streaming SSR</span>
          </li>
          <li class="flex gap-2 text-[0.8rem] leading-snug text-muted">
            <span class="text-accent" aria-hidden="true">▸</span>
            <span>Hybrid SSR / SSG / CSR per route</span>
          </li>
        </ul>
        <p class="m-0 flex flex-wrap gap-x-2.5 gap-y-0.5 text-[0.72rem] text-muted">
          <span>This website is built with avedon.</span>
          <span class="text-fg/20" aria-hidden="true">/</span>
          <span>compiler · runtime · server</span>
          <span class="text-fg/20" aria-hidden="true">/</span>
          <span>adapters: node · bun · cloudflare</span>
          <span class="text-fg/20" aria-hidden="true">/</span>
          <span>open source</span>
        </p>
      </div>
    </section>
  </div>
</template>
